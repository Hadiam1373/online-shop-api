# Environment variables
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000

# Database (for local development - connects to Docker container)
DATABASE_URL="postgresql://admin:123456@localhost:5433/shopdb"

# Redis local
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET=supersecretkey
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Docker service (uncomment when running in Docker)
# REDIS_URL=redis://:redis_password@redis:6379

# Other
SALT_ROUNDS=12

# Zarinpal Payment Gateway
ZARINPAL_MERCHANT_ID=00000000-0000-0000-0000-000000000000
ZARINPAL_SANDBOX=true
ZARINPAL_CALLBACK_URL=http://localhost:5000/api/payments/zarinpal/callback

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_CURRENCY=usd